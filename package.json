{
  "name": "asado-today",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "lint:svelte": "eslint 'src/**/*.svelte'",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deadcode": "knip",
    "cycles": "madge --circular --extensions ts,js,svelte src/",
    "sec:secrets": "gitleaks detect --no-banner --no-color",
    "sec:deps": "osv-scanner scan --lockfile pnpm-lock.yaml",
    "sec:sast": "semgrep scan --config auto src/",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "agent:check": "pnpm lint && pnpm lint:svelte && pnpm typecheck && pnpm test:unit && pnpm build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "knip": "^6.44.1",
    "madge": "^8.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "wrangler": "^4.157.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
